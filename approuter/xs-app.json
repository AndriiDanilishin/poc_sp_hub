{
  "welcomeFile": "/poc.sp.hub.intakehub/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^(?:/[\\w.-]+)?/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
