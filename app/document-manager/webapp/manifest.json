{
  "_version": "1.86.0",
  "sap.app": {
    "id": "poc.sp.hub.documentmanager",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "8a50b177-688a-4fc6-8f77-d68b92ea4ed9"
    },
    "dataSources": {
      "mainService": {
        "uri": "api/knowledge/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "documentmanager-manage": {
          "semanticObject": "KnowledgeDocument",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://course-book",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "poc.sp.hub"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "poc.sp.hub.documentmanager.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "KnowledgeDocumentsList",
          "target": [
            "KnowledgeDocumentsList"
          ]
        },
        {
          "pattern": "KnowledgeDocuments({key}):?query:",
          "name": "KnowledgeDocumentsObjectPage",
          "target": [
            "KnowledgeDocumentsList",
            "KnowledgeDocumentsObjectPage"
          ]
        }
      ],
      "targets": {
        "KnowledgeDocumentsList": {
          "type": "Component",
          "id": "KnowledgeDocumentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/KnowledgeDocuments",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "KnowledgeDocuments": {
                  "detail": {
                    "route": "KnowledgeDocumentsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi"
                  },
                  "actions": {
                    "uploadFile": {
                      "press": "poc.sp.hub.documentmanager.ext.fragment.UploadDialog.onOpenUpload",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>uploadFileAction}"
                    },
                    "askKnowledge": {
                      "press": "poc.sp.hub.documentmanager.ext.fragment.AskDialog.onOpenAsk",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>askAction}"
                    },
                    "reindexMissing": {
                      "press": "poc.sp.hub.documentmanager.ext.fragment.KnowledgeActions.onReindexMissing",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>reindexMissingAction}"
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "KnowledgeDocumentsObjectPage": {
          "type": "Component",
          "id": "KnowledgeDocumentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/KnowledgeDocuments",
              "content": {
                "body": {
                  "sections": {
                    "SimilarSection": {
                      "template": "poc.sp.hub.documentmanager.ext.fragment.SimilarSection",
                      "position": {
                        "placement": "After",
                        "anchor": "IndexingFacet"
                      },
                      "title": "{i18n>similarSectionTitle}"
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/KnowledgeDocuments({key})"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
