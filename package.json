{
  "name": "poc_sp_hub",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/cds": "10.0.5",
    "@sap/xssec": "^4",
    "mbt": "^1.2.49",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "10.0.6",
    "cds-plugin-ui5": "0.13.6",
    "eslint": "^10",
    "prettier": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "build:cf": "cds build --production",
    "mta:build": "npx mbt build",
    "cf:deploy": "cf deploy mta_archives/poc-sp-hub_1.0.0.mtar",
    "watch-document-manager": "cds watch --open poc.sp.hub.documentmanager/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-intake-hub": "cds watch --open poc.sp.hub.intakehub/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-sourcing-project": "cds watch --open poc.sp.hub.sourcingproject/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-requirement-workspace": "cds watch --open poc.sp.hub.requirementworkspace/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "node test/run-http.js",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "cds": {
    "s4": {
      "provider": "mock",
      "destinationName": "S4HANA_PR",
      "servicePath": "/sap/opu/odata/sap/API_PURCHASEREQ_PROCESS_SRV",
      "validateOnly": false,
      "timeoutMs": 30000,
      "defaults": {
        "purchaseRequisitionType": "NB",
        "plant": "2610",
        "companyCode": "2610",
        "purchasingOrganization": "2610",
        "purchasingGroup": "001",
        "itemCategory": "0",
        "accountAssignmentCategory": "K",
        "costCenter": "26101101",
        "glAccount": "51100000",
        "currency": "PLN"
      },
      "unitMap": {
        "PC": "PC",
        "PCS": "PC",
        "EA": "PC",
        "EACH": "PC",
        "PIECE": "PC",
        "PIECES": "PC",
        "UNIT": "PC",
        "UNITS": "PC",
        "KG": "KG",
        "G": "G",
        "L": "L",
        "ML": "ML",
        "M": "M",
        "H": "H"
      }
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "dummy"
      },
      "[mocked]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "curator": {
              "roles": [
                "KnowledgeCurator"
              ]
            },
            "requester": {
              "roles": [
                "ProcurementRequester"
              ]
            },
            "manager": {
              "roles": [
                "ProcurementRequester",
                "ProcurementManager"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana",
          "deploy-format": "hdbtable"
        },
        "destinations": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/document-manager",
    "app/intake-hub",
    "app/sourcing-project",
    "app/requirement-workspace"
  ]
}
